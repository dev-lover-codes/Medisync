# Supabase Configuration
# The URL of your Supabase project (found in Project Settings > API)
VITE_SUPABASE_URL=your_supabase_project_url

# The public anon key for your Supabase project (found in Project Settings > API)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Anthropic Configuration
# Your Anthropic API key for AI-powered features
ANTHROPIC_API_KEY=your_anthropic_api_key

# Legacy / Backend Configuration (if applicable)
# These are kept for compatibility with existing deployment scripts
REACT_APP_SUPABASE_URL=${VITE_SUPABASE_URL}
REACT_APP_SUPABASE_ANON_KEY=${VITE_SUPABASE_ANON_KEY}
REACT_APP_ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}
